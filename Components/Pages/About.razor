@page "/about"

<div class="about-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <nav class="navbar">
            <span class="brand-logo">My Closet</span>
            <div class="nav-links">
                <a href="/" class="nav-link">home</a>
                <a href="/about" class="nav-link active">about</a>
                <a href="/works" class="nav-link">works</a>
            </div>
        </nav>

        <div class="hero-content">
            <div class="hero-text">
                <div class="heading-group">
                    <span class="title-about">About</span>
                    <span class="title-me">Me</span>
                </div>
                <p class="hero-description">
                    What's a computer science degree gonna make me do?<br />
                    Create a website about all the things I love and do!
                </p>
                <div>
                    <a href="/works" class="btn-works">View Works</a>
                </div>
            </div>

            <!-- Overlapping Hero Illustration Stack -->
            <div class="hero-illustration-container">
                <img src="assets/e3f0a.png" alt="Building at night" class="img-building" />
                <img src="assets/86625.png" alt="Woman walking dog" class="img-woman" />
            </div>
        </div>
    </div>

    <!-- Ultimate Favorites Section -->
    <section class="favorites-section">
        <div class="section-heading">
            <p class="title-ultimate">Ultimate</p>
            <p class="subtitle-favorites">Favorites</p>
        </div>

        <div class="cards-grid">
            <!-- Card 1 -->
            <div class="favorite-card">
                <div class="circle-frame">
                    <img src="assets/d8dba.png" alt="Mix and Matching Clothes" class="card-img" />
                </div>
                <p class="card-title">Mix and Matching<br />Clothes!</p>
            </div>

            <!-- Card 2 -->
            <div class="favorite-card">
                <div class="circle-frame">
                    <img src="assets/d6674.png" alt="Working on my Computer" class="card-img" />
                </div>
                <p class="card-title">Working on my<br />Computer</p>
            </div>

            <!-- Card 3 -->
            <div class="favorite-card">
                <div class="circle-frame">
                    <img src="assets/9a26a.png" alt="Browsing and Reading Books" class="card-img" />
                </div>
                <p class="card-title">Browsing and<br />Reading Books</p>
            </div>
        </div>
    </section>
</div>