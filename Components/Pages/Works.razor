@page "/works"

<div class="works-page">

    <!-- Header -->
    <header class="works-header">
        <a href="/" class="works-logo">My Closet</a>
        <nav class="works-nav">
            <a href="/" class="nav-link">home</a>
            <a href="/about" class="nav-link">about</a>
            <a href="/works" class="nav-link nav-link--active">works</a>
        </nav>
    </header>

    <!-- Hero: Fit of the Day -->
    <section class="works-hero">
        <div class="hero-text">
            <span class="hero-fit">Fit</span>
            <span class="hero-ofthe">of the</span>
            <span class="hero-day">Day</span>
        </div>
    </section>

    <!-- Outfit illustrations -->
    <section class="works-gallery">

        <!-- Left figure -->
        <div class="figure figure--left">
            <img class="figure__ellipse" src="/assets/31a68.svg" alt="" aria-hidden="true" />
            <img class="figure__img" src="/assets/5635e.png" alt="Fashion illustration – polka-dot dress" />
        </div>

        <!-- Centre figure -->
        <div class="figure figure--center">
            <img class="figure__ellipse" src="/assets/f35cb.svg" alt="" aria-hidden="true" />
            <img class="figure__img" src="/assets/7922e.png" alt="Fashion illustration – Barbie ballgown" />
        </div>

        <!-- Right figure -->
        <div class="figure figure--right">
            <img class="figure__ellipse" src="/assets/87cc6.svg" alt="" aria-hidden="true" />
            <img class="figure__img" src="/assets/5c74f.png" alt="Fashion illustration – black gown" />
        </div>

    </section>

    <!-- Footer band -->
    <footer class="works-footer">
        <h2 class="footer-title">About My Works</h2>
        <p class="footer-body">
            I work as a hobby designer and software developer. Most of my projects involve
            using technology for good.
        </p>
    </footer>

</div>
